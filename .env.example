# C236T Controller environment variables
# Copy to .env and fill in the values.
#
# Local LAN control (primary path)
THING_LOCAL_KEY="your-16-byte-local-key"
THING_LOCAL_IP=192.168.1.100
THING_LOCAL_PORT=6668
THING_DEV_ID=your-device-id

# Legacy cloud path (not used by the CLI; retained for reference)
# The app key/secret are the public values embedded in the official
# app binary (not secrets). Keep them only if you need the cloud path.
THING_APP_KEY=your-app-key
THING_APP_SECRET=your-app-secret
THING_USERNAME=you@example.com
THING_PASSWORD=your-password
THING_COUNTRY_CODE=61
THING_USER_TOKEN=
